# Normalize line endings so checkouts and cold-sink hashes agree across platforms.
* text=auto eol=lf

*.py text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf

*.png binary
*.jpg binary
*.gif binary
*.db binary
*.sqlite3 binary
*.whl binary
