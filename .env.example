# Every variable is optional. With none set, the kernel and Gauge VM run fully
# offline against in-memory SQLite stores. Invalid numeric values fail fast.
# Copy to .env or export these in your shell (see early_agi/config.py).

# Live dual-tier routing is opt-in. Set all four values for a local server.
# EARLY_AGI_LLM_ENABLED=1
# EARLY_AGI_BASE_URL=http://localhost:11434/v1
# EARLY_AGI_FAST_MODEL=qwen2.5-coder:7b
# EARLY_AGI_DEEP_MODEL=qwen2.5-coder:32b

# Only needed for hosted endpoints.
# EARLY_AGI_API_KEY=

# Transport
# EARLY_AGI_TIMEOUT=90
# EARLY_AGI_MAX_RETRIES=2
# EARLY_AGI_TEMPERATURE=0

# Physics / governor. The backend selector accepts classical_svd (default),
# bounded_chi, thrml, thrml_informed, and thrml_pbit. The thrml aliases use the
# bundled pure-Python block-Gibbs backend and report optional THRML/JAX
# availability; install `.[thrml]` only for a dedicated adapter environment.
# EARLY_AGI_BACKEND=classical_svd
# EARLY_AGI_CHI_MAX=4
# EARLY_AGI_TAU=0.15
# EARLY_AGI_ETA_HIGH=1.2
# EARLY_AGI_ETA_MIN=0.15

# Storage and scanning. Defaults are in-memory and 200 files.
# EARLY_AGI_SINK=:memory:
# EARLY_AGI_MERA=:memory:
# EARLY_AGI_DIRECTIVE_DB=:memory:
# EARLY_AGI_MAX_FILES=200
